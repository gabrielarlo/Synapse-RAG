# Copy to .env and fill in. Never commit .env.
# Required secrets — boot fails fast when missing.
JWT_SECRET=change-me-to-a-long-random-secret
# NOTE: these values are used BOTH natively and inside containers. Inside a
# container, `localhost` is the container itself — for a host-run PGSQL use
# host.docker.internal (Docker Desktop) or your LAN IP as DATABASE_HOST.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=synapse
DATABASE_USER=synapse
DATABASE_PASSWORD=change-me-too
OLLAMA_URL=http://localhost:11434

# Ports
API_PORT=8000
UI_PORT=5173
# Browser origins allowed to call the API directly (absolute VITE_API_URL).
# Relative /api calls in compose go through the UI's nginx proxy instead.
CORS_ALLOW_ORIGINS=*

# Ollama models (must serve /api/generate + /api/embed on the Ollama host;
# embed dim must match vector(N)). NOTE: d1* models in current Ollama builds
# do not serve /api/generate — use a completion model for decisions.
OLLAMA_GEN_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_DECISION_MODEL=llama3.2:3b
EMBED_DIM=768

# Auth / limits
JWT_EXPIRE_MIN=30
REFRESH_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=60
FAQ_RATE_LIMIT=60
FAQ_RATE_WINDOW_S=60

# Session memory (minutes of inactivity before context expires)
SESSION_TTL_MIN=30
SESSION_DB_PATH=/data/sessions.db
UPLOAD_DIR=/data/uploads

# First-admin seed (used by infra/seed.py)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=change-me-too
